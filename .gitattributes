# Disable automatic line ending conversion
* -text

# Explicitly set line endings for known text file types
*.cs      text eol=lf
*.cshtml  text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.sln     text eol=lf
*.slnx    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.xml     text eol=lf
*.config  text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.sh      text eol=lf

# Patch files carry unified-diff context lines where a blank line is encoded as
# a single space; that is valid content, not a whitespace error. Skip the
# whitespace check so `git diff --check` does not flag generated .patch files.
*.patch   text eol=lf -whitespace

# VICE keymap files are vendored verbatim as GPL-2.0-or-later data (PLAN-XBOXUWP
# S32; Xbox head Assets/vice-data/C64). Upstream ships them with intentional
# trailing whitespace; they must be redistributed unmodified, so skip the
# whitespace check and pin LF so `git diff --check` does not flag the vendored data.
*.vkm     text eol=lf -whitespace

# Additional repository text formats.
.gitattributes text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.txt        text eol=lf
*.log        text eol=lf
*.appxmanifest text eol=lf

# Retained transcripts, receipts, and generated requirement exports preserve
# source formatting as audit evidence; whitespace there is data, not style.
docs/grok/**                              -whitespace
docs/Project/**                           -whitespace
docs/receipts/**                          -whitespace
docs/*.log                                -whitespace
docs/receipts-*.txt                       -whitespace
docs/*-dump.txt                           -whitespace
artifacts/vice-parity-requirements/**     -whitespace
docs/PRIVACY.md                            -whitespace
docs/audit-vic20-vs-vice-2026-08-07.md    -whitespace

# Binary files - never modify
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary
*.rom     binary
*.bin     binary
*.dll     binary
*.exe     binary
*.so      binary
*.dylib   binary
