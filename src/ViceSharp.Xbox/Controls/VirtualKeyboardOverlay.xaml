<!--
  PLAN-XBOXUWP S34 + PLAN-XKEYBOARD-001 K2: the on-screen REAL C64 keyboard. NOT an
  overlay: the App docks this control in the root grid's bottom Auto row, so showing it
  SHRINKS the emulator's star row above (never occludes the display), and the native
  bottom-edge transition slides it up. Binds VirtualKeyboardViewModel: the five physical
  rows in the center, the F1..F7 function column on the RIGHT (as on the machine), and
  every tile sized from the layout's true width units. Inert on the net10.0 fallback
  (code-behind is #if HAS_UWP-guarded).
-->
<UserControl
    x:Class="ViceSharp.Xbox.Controls.VirtualKeyboardOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ViceSharp.Xbox.Controls"
    xmlns:vm="using:ViceSharp.Xbox.ViewModels"
    RequiresPointer="Never">
    <UserControl.Resources>
        <!-- Width units -> pixels (one key unit = 52 px at 10-foot scale). -->
        <controls:KeyWidthConverter x:Key="KeyWidth" UnitPixels="52" />
    </UserControl.Resources>

    <!-- Slide up from the bottom edge when the dock becomes visible. -->
    <UserControl.Transitions>
        <TransitionCollection>
            <EdgeUIThemeTransition Edge="Bottom" />
        </TransitionCollection>
    </UserControl.Transitions>

    <Border Background="#F0181C20" BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0" Padding="16,12">
        <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The five physical rows. -->
            <ItemsControl Grid.Column="0" ItemsSource="{x:Bind ViewModel.KeyRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VirtualKeyboardRow">
                        <ItemsControl ItemsSource="{x:Bind Keys}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VirtualKeyEntry">
                                    <!--
                                      FEAT-XKEYCAPSTYLE-001 (operator 2026-07-14: "Apply
                                      CBM button style to the virtual keyboad"): the
                                      app-level breadbin keycap tile style (PetMe64 face,
                                      warm brown cap, raised-key bevel).
                                    -->
                                    <Button
                                        Content="{x:Bind DisplayLabel}"
                                        Width="{x:Bind EffectiveWidthUnits, Converter={StaticResource KeyWidth}}"
                                        FontSize="{x:Bind DisplayFontSize}"
                                        Style="{StaticResource C64KeycapTileStyle}"
                                        Click="OnKeyPressed" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The function-key column, on the RIGHT like the physical machine. -->
            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Layout.FunctionKeys}" Margin="16,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VirtualKeyEntry">
                        <Button
                            Content="{x:Bind DisplayLabel}"
                            Width="{x:Bind EffectiveWidthUnits, Converter={StaticResource KeyWidth}}"
                            FontSize="{x:Bind DisplayFontSize}"
                            Style="{StaticResource C64KeycapTileStyle}"
                            Click="OnKeyPressed" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
