<!--
  PLAN-XBOXUWP S34 (IMPL-XBOXUWP-034): the in-game quick-menu overlay (Menu button). A first
  realization with the common quick actions; the operator wires each button's command on the
  dev PC. Inert on the net10.0 fallback (its code-behind is #if HAS_UWP-guarded).
-->
<UserControl
    x:Class="ViceSharp.Xbox.Controls.QuickMenuOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequiresPointer="Never">
    <Grid Background="#AA000000">
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#EE202020"
            CornerRadius="12"
            Padding="32">
            <StackPanel Spacing="8" MinWidth="360">
                <TextBlock Text="Quick menu" FontSize="32" Foreground="White" HorizontalAlignment="Center" />
                <Button Content="Resume" HorizontalAlignment="Stretch" Click="OnResume" />
                <Button Content="Warm reset" HorizontalAlignment="Stretch" Click="OnClose" />
                <Button Content="Quick save" HorizontalAlignment="Stretch" Click="OnClose" />
                <Button Content="Quick load" HorizontalAlignment="Stretch" Click="OnClose" />
                <Button Content="Close" HorizontalAlignment="Stretch" Click="OnClose" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
