<!--
  PLAN-XBOXUWP S34 (IMPL-XBOXUWP-034): app-wide 10-foot (couch) focus visuals.

  This ResourceDictionary is merged into App.Resources. It is inert on the workload-free
  net10.0 fallback build (no XAML compiler without UseUwp) and processed only by the real
  UWP build.

  - RequiresPointer="Never" turns OFF mouse mode app-wide (the app is controller-driven;
    App.OnLaunched also sets Application.RequiresPointerMode = WhenRequested as the
    authoritative process-wide switch). The implicit Page style covers Page-typed roots.
  - A high-visibility reveal focus visual (thick, high-contrast) so the focused element is
    unmistakable across a room on a TV.
  - The TV-safe-area margin insets the root content to ~90% of the panel (5% per edge) so
    nothing lands under a TV's overscan.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ~5% per-edge inset for 1920x1080 (96px x, 54px y): the 90% TV-safe area. -->
    <Thickness x:Key="TvSafeAreaMargin">96,54,96,54</Thickness>

    <!-- High-visibility focus reveal colours. -->
    <SolidColorBrush x:Key="AppFocusPrimaryBrush" Color="#FFFFD400" />
    <SolidColorBrush x:Key="AppFocusSecondaryBrush" Color="#FF101010" />

    <!-- Turn off mouse mode on Page-typed roots (10-foot UI is controller-only). -->
    <Style TargetType="Page">
        <Setter Property="RequiresPointer" Value="Never" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <!-- Reusable root container style: TV-safe-area inset + a dark 10-foot backdrop. -->
    <Style x:Key="TvSafeAreaRootStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource TvSafeAreaMargin}" />
    </Style>

    <!-- A thick, high-contrast focus visual for controller navigation. -->
    <Style x:Key="TenFootButtonStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AppFocusPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AppFocusSecondaryBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="4" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="FontSize" Value="24" />
    </Style>

</ResourceDictionary>
