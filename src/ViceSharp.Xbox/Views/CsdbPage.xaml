<!--
  PLAN-ROMM-001 X4 (FR-CSDB-001, AC-CSDB-01/02/04/05): the CSDb discovery page (10-foot). Search scene
  releases through the csdb-bridge sidecar, select up to 20, and Ingest+scan them into RomM (the bridge
  writes the files; the gateway triggers the RomM scan). Inert on the net10.0 fallback (the code-behind
  is #if HAS_UWP-guarded).
-->
<Page
    x:Class="ViceSharp.Xbox.Views.CsdbPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvm="using:ViceSharp.Library.ViewModels"
    RequiresPointer="Never"
    Background="#EE000000">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="CSDb discovery" FontSize="40" Foreground="White" VerticalAlignment="Center" />
            <TextBox x:Name="ServerBox" PlaceholderText="RomM http://host:8080/" Text="http://localhost:8080/" Width="300" />
            <PasswordBox x:Name="TokenBox" PlaceholderText="Client API token" Width="240" />
            <TextBox x:Name="BridgeBox" PlaceholderText="bridge http://host:8090/" Text="http://localhost:8090/" Width="300" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" PlaceholderText="Search scene releases..." Width="420" />
            <ToggleButton x:Name="DemoToggle" Content="Demo" />
            <ToggleButton x:Name="CrackToggle" Content="Crack" />
            <ToggleButton x:Name="SidToggle" Content="SID" />
            <Button Content="Search" Style="{StaticResource TenFootButtonStyle}" Click="OnSearch" />
        </StackPanel>

        <ListView x:Name="ResultsList" Grid.Row="2" SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lvm:CsdbHit">
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{x:Bind Title}" FontSize="24" Foreground="White" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind TypeLabel}" FontSize="16" Foreground="#FFBBBBBB" />
                            <TextBlock Text="{x:Bind Source}" FontSize="16" Foreground="#FF889988" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Ingest and scan" Style="{StaticResource TenFootButtonStyle}" Click="OnIngest" />
            <Button Content="Back" Style="{StaticResource TenFootButtonStyle}" Click="OnBack" />
            <TextBlock x:Name="StatusText" Text="Enter your RomM + bridge URLs and token, then Search (max 20 per ingest)." Foreground="#FFDDDDDD" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />
        </StackPanel>
    </Grid>
</Page>
