<!--
  PLAN-ROMM-001 X3 (AC-XUI-06): list management with Library-like connect, List/Grid member views,
  and Attach / Attach+autostart on selected titles (Recents + server collections).
-->
<Page
    x:Class="ViceSharp.Xbox.Views.ListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvm="using:ViceSharp.Library.ViewModels"
    RequiresPointer="Never"
    Background="#F00A0A0A">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Lists" FontSize="40" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="ListViewButton" Content="List" Style="{StaticResource TenFootButtonStyle}"
                        MinWidth="100" MinHeight="48" FontSize="18" Margin="0" Click="OnShowListView" />
                <Button x:Name="GridViewButton" Content="Grid" Style="{StaticResource TenFootButtonStyle}"
                        MinWidth="100" MinHeight="48" FontSize="18" Margin="0" Click="OnShowGridView" />
                <TextBlock x:Name="CountText" Text="" Foreground="#FFB8B8B8" FontSize="18" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="BrowseArea" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                <ListView x:Name="CollectionsList" SelectionMode="Single" SelectionChanged="OnCollectionSelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lvm:LibraryCollection">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6">
                                <TextBlock Text="{x:Bind Name}" FontSize="22" Foreground="White" />
                                <TextBlock Text="{x:Bind Count.ToString()}" FontSize="18" Foreground="#FF88AA88" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Column="1">
                <!-- List view of members -->
                <ListView x:Name="MembersList" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnMemberClick" SelectionChanged="OnMemberSelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="#14FFFFFF" CornerRadius="8" Padding="8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lvm:RomTile">
                            <Grid Margin="0,6" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64" Background="#1AFFFFFF" CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" FontSize="11" Foreground="#FF888888"
                                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="4" />
                                        <Image x:Name="ListCoverImage" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="20" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind FileName}" FontSize="14" Foreground="#FF9A9A9A" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind VariantLabel}" FontSize="13" Foreground="#FF7A9A7A" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Grid (cover) view of members -->
                <GridView x:Name="MembersGrid" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnMemberClick" SelectionChanged="OnMemberSelectionChanged"
                          ContainerContentChanging="OnMemberContainerChanging"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="#14FFFFFF" CornerRadius="8" Padding="8"
                          Visibility="Collapsed">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="lvm:RomTile">
                            <Grid Width="154" Height="170" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#1AFFFFFF" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" Foreground="#FF8A8A8A" FontSize="13" TextAlignment="Center"
                                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" />
                                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,6,2,0">
                                    <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind FileName}" Foreground="#FF9A9A9A" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

        <Border x:Name="ConnectPanel" Grid.Row="1" Background="#CC141414" CornerRadius="12" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="740">
            <StackPanel Spacing="12">
                <TextBlock Text="Connect to your RomM server" FontSize="26" Foreground="White" />
                <TextBox x:Name="UrlBox" PlaceholderText="http://host:8080/" Text="http://localhost:8080/" />
                <PasswordBox x:Name="TokenBox" PlaceholderText="Client API token (optional when a bridge is present)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Scan LAN" Style="{StaticResource TenFootButtonStyle}" Click="OnScan" />
                    <Button Content="Connect" Style="{StaticResource TenFootButtonStyle}" Click="OnConnect" />
                </StackPanel>
                <TextBlock x:Name="ConnectStatus" Text="Looking for a remembered RomM server..." Foreground="#FFDDDDDD" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Selected title + attach actions -->
        <Border x:Name="SelectionBar" Grid.Row="2" Background="#26FFFFFF" CornerRadius="8" Padding="16,10" Margin="0,12,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedText" Text="No game selected" Foreground="White" FontSize="18" />
                    <TextBlock x:Name="StatusText" Text="" Foreground="#FFCFCFCF" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="(A) Attach" Style="{StaticResource TenFootButtonStyle}" MinWidth="160" MinHeight="52" FontSize="18" Margin="0" Click="OnAttach" />
                    <Button Content="(Y) Autostart" Style="{StaticResource TenFootButtonStyle}" MinWidth="180" MinHeight="52" FontSize="18" Margin="0" Click="OnAttachAutostart" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="ActionBar" Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBox x:Name="NameBox" PlaceholderText="List name" Width="240" VerticalAlignment="Center" />
            <Button Content="New list" Style="{StaticResource TenFootButtonStyle}" Click="OnNewList" />
            <Button Content="Rename" Style="{StaticResource TenFootButtonStyle}" Click="OnRename" />
            <Button Content="Delete" Style="{StaticResource TenFootButtonStyle}" Click="OnDelete" />
            <Button Content="(B) Back" Style="{StaticResource TenFootButtonStyle}" Click="OnBack" />
        </StackPanel>
    </Grid>
</Page>
