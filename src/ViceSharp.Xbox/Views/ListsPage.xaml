<!--
  PLAN-ROMM-001 X3 (AC-XUI-06): the RomM list-management page (10-foot). Connect to the RomM server,
  browse the user's server-side collections, and create / rename / delete lists + inspect their
  membership. Binds CollectionsViewModel. Inert on the net10.0 fallback (the code-behind is
  #if HAS_UWP-guarded).
-->
<Page
    x:Class="ViceSharp.Xbox.Views.ListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvm="using:ViceSharp.Library.ViewModels"
    RequiresPointer="Never"
    Background="#EE000000">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Lists" FontSize="40" Foreground="White" VerticalAlignment="Center" />
            <TextBox x:Name="UrlBox" PlaceholderText="http://host:8080/" Text="http://localhost:8080/" Width="320" />
            <PasswordBox x:Name="TokenBox" PlaceholderText="Client API token" Width="260" />
            <Button Content="Connect" Style="{StaticResource TenFootButtonStyle}" Click="OnConnect" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="CollectionsList" Grid.Column="0" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="lvm:LibraryCollection">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                            <TextBlock Text="{x:Bind Name}" FontSize="24" Foreground="White" />
                            <TextBlock Text="{x:Bind Count.ToString()}" FontSize="20" Foreground="#FF88AA88" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="MembersList" Grid.Column="1" SelectionMode="None" Margin="24,0,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontSize="22" Foreground="#FFDDDDDD" Margin="0,2" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBox x:Name="NameBox" PlaceholderText="List name" Width="280" />
            <Button Content="New list" Style="{StaticResource TenFootButtonStyle}" Click="OnNewList" />
            <Button Content="Rename" Style="{StaticResource TenFootButtonStyle}" Click="OnRename" />
            <Button Content="Delete" Style="{StaticResource TenFootButtonStyle}" Click="OnDelete" />
            <Button Content="Back" Style="{StaticResource TenFootButtonStyle}" Click="OnBack" />
            <TextBlock x:Name="StatusText" Text="Enter your RomM URL and token, then Connect." Foreground="#FFDDDDDD" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
        </StackPanel>
    </Grid>
</Page>
