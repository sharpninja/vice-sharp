<!--
  PLAN-XBOXUWP S34 (IMPL-XBOXUWP-034): the device-setup page. Binds XboxDeviceSetupViewModel
  (four peripheral cards + true-drive). A first realization: shows the cards and status; the
  operator adds the storage-picker attach flow on the dev PC. Inert on the net10.0 fallback.
-->
<Page
    x:Class="ViceSharp.Xbox.Views.DeviceSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xvm="using:ViceSharp.Xbox.ViewModels"
    RequiresPointer="Never"
    Background="#EE000000">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Devices" FontSize="48" Foreground="White" Margin="0,0,0,16" />

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Slots, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="xvm:XboxMediaSlotViewModel">
                    <Grid Margin="0,8" Padding="16" Background="#22FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="28" Foreground="White" />
                        <TextBlock Grid.Column="1" Text="{x:Bind MediaKind}" FontSize="24" Foreground="#FFAAAAAA" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" FontSize="24" Foreground="#FFCCCCCC" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="#FFAADDAA" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Back" Style="{StaticResource TenFootButtonStyle}" Click="OnBack" />
        </StackPanel>
    </Grid>
</Page>
