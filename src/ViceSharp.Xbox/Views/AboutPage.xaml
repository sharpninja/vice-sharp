<!--
  PLAN-XBOXUWP S34 (IMPL-XBOXUWP-034): the About / GPL disclosure page. Binds AboutViewModel
  (license identity, VICE attribution, source offer + URL, build version). Inert on the
  net10.0 fallback.
-->
<Page
    x:Class="ViceSharp.Xbox.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequiresPointer="Never"
    Background="#EE000000">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="1200">
                <TextBlock Text="{Binding ProjectName}" FontSize="56" Foreground="White" />
                <TextBlock Text="{Binding Version}" FontSize="24" Foreground="#FFBBBBBB" />
                <TextBlock Text="{Binding LicenseIdentifier}" FontSize="28" Foreground="White" />
                <TextBlock Text="{Binding AttributionText}" TextWrapping="Wrap" Foreground="#FFDDDDDD" />
                <TextBlock Text="{Binding SourceOfferText}" TextWrapping="Wrap" Foreground="#FFDDDDDD" />
                <TextBlock Text="{Binding SourceUrl}" Foreground="#FF8CB4FF" />
                <Button Content="Back" Style="{StaticResource TenFootButtonStyle}" Click="OnBack" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
