<!--
  PLAN-XBOXUWP: the shell menu, an OVERLAY over the always-running emulator. The Page is fully
  transparent so the EmulatorView base (and the C64, held PAUSED while the menu is up,
  FEAT-XMENUPAUSE-001) shows through; the menu lives in a bounded, translucent card kept inside
  the TV-safe area. Menu redesign (operator 2026-07-14): Save/Load persist and restore a machine
  snapshot (FEAT-XMENUSNAP-001), every dismissal resumes the machine, and Restart (cold reset)
  is the LAST button. Inert on the net10.0 fallback.
-->
<Page
    x:Class="ViceSharp.Xbox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequiresPointer="Never"
    Background="Transparent">
    <!--
      TV-safe inset (96,54) so the card never lands under a TV's overscan. The root is
      hit-testable (explicit transparent background) so a mouse click on the emulator area
      OUTSIDE the card dismisses the menu without touching the emulator (OnBackgroundDismiss).
    -->
    <Grid
        x:Name="BackgroundRoot"
        Style="{StaticResource TvSafeAreaRootStyle}"
        Background="Transparent"
        PointerPressed="OnBackgroundDismiss">
        <!--
          Bounded, translucent menu card: a left-aligned, vertically-centred rail so the running
          emulator shows around it on the right and faintly through the card. Change
          HorizontalAlignment to "Center" for a centred card.
        -->
        <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#C0101418"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="32">
            <StackPanel Spacing="12" MinWidth="360">
                <TextBlock
                    Text="{Binding Title}"
                    FontSize="56"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8" />
                <!--
                  Menu redesign (operator 2026-07-14): SAVE/LOAD persist and restore a
                  snapshot of the machine the menu is holding PAUSED; RESUME is gone
                  (dismissing the menu resumes); RESTART (cold reset) is the LAST button.
                -->
                <Button
                    Content="Save"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnSave" />
                <Button
                    Content="Load"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnLoad" />
                <Button
                    Content="Settings"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnSettings" />
                <Button
                    Content="Devices"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnDevices" />
                <Button
                    Content="Controls"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnControls" />
                <Button
                    Content="About"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnAbout" />
                <!--
                  Mouse-friendly dismiss (operator 2026-07-14): reveals the emulator and
                  resumes it (FEAT-XMENUPAUSE-001). Clicking the transparent background
                  outside the card does the same.
                -->
                <Button
                    Content="Close Menu"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnCloseMenu" />
                <Button
                    Content="Restart"
                    Style="{StaticResource TenFootButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnRestart" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
