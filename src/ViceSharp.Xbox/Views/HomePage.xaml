<!--
  PLAN-XBOXUWP S34 (IMPL-XBOXUWP-034): the launch / Home page. Binds HomeViewModel
  (Title / CanResume + Start/Resume/About intents). Inert on the net10.0 fallback.
-->
<Page
    x:Class="ViceSharp.Xbox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequiresPointer="Never"
    Background="#CC000000">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock
                Text="{Binding Title}"
                FontSize="72"
                Foreground="White"
                HorizontalAlignment="Center" />
            <Button
                Content="Start"
                Style="{StaticResource TenFootButtonStyle}"
                HorizontalAlignment="Center"
                Click="OnStart" />
            <Button
                Content="Resume"
                Style="{StaticResource TenFootButtonStyle}"
                HorizontalAlignment="Center"
                IsEnabled="{Binding CanResume}"
                Click="OnResume" />
            <Button
                Content="Settings"
                Style="{StaticResource TenFootButtonStyle}"
                HorizontalAlignment="Center"
                Click="OnSettings" />
            <Button
                Content="Devices"
                Style="{StaticResource TenFootButtonStyle}"
                HorizontalAlignment="Center"
                Click="OnDevices" />
            <Button
                Content="Controls"
                Style="{StaticResource TenFootButtonStyle}"
                HorizontalAlignment="Center"
                Click="OnControls" />
            <Button
                Content="About"
                Style="{StaticResource TenFootButtonStyle}"
                HorizontalAlignment="Center"
                Click="OnAbout" />
        </StackPanel>
    </Grid>
</Page>
