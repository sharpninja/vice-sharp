<!--
  PLAN-XBOXUWP S34 + FEAT-XCTRLBIND-001: Controls page. Shows locked joystick rows and
  remappable system buttons. Save/Reset persist via IBindingStore; Cycle rebinds the
  selected unlocked row through the next AppCommand. Inert on the net10.0 fallback.
-->
<Page
    x:Class="ViceSharp.Xbox.Views.InputMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ViceSharp.Xbox.ViewModels"
    RequiresPointer="Never"
    Background="#EE000000">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Controls" FontSize="48" Foreground="White" Margin="0,0,0,16" />

        <ListView
            x:Name="MappingList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:InputMappingRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind InputLabel}" FontSize="26" Foreground="White" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ActionLabel}" FontSize="26" Foreground="#FFCCCCCC" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            FontSize="20"
            Foreground="#FFAADDAA"
            Margin="0,8,0,8" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cycle command" Style="{StaticResource TenFootButtonStyle}" Click="OnCycleCommand" />
            <Button Content="Save" Style="{StaticResource TenFootButtonStyle}" Click="OnSave" />
            <Button Content="Reset defaults" Style="{StaticResource TenFootButtonStyle}" Click="OnReset" />
            <Button Content="Virtual keyboard" Style="{StaticResource TenFootButtonStyle}" Click="OnVirtualKeyboard" />
            <Button Content="Back" Style="{StaticResource TenFootButtonStyle}" Click="OnBack" />
        </StackPanel>
    </Grid>
</Page>
