<!-- FR-FLASHCART-001: UWP 10-foot flash cart image builder (FE3 / Ultimem / Mega-Cart). -->
<Page
    x:Class="ViceSharp.Xbox.Views.FlashCartBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fc="using:ViceSharp.Core.FlashCarts"
    RequiresPointer="Never"
    Background="#EE000000">
    <Grid Style="{StaticResource TvSafeAreaRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Flash cart builder" FontSize="40" Foreground="White" />
            <TextBlock x:Name="SummaryText" FontSize="20" Foreground="#FFAAAAAA" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" MaxWidth="1000">
                <ComboBox x:Name="ProfileBox" Header="Profile" SelectionChanged="OnProfileChanged" />
                <ToggleSwitch x:Name="PrgToggle" Header="Treat imports as PRG" IsOn="True" Toggled="OnPrgToggled" />
                <ListView x:Name="BankList"
                          SelectionMode="Single"
                          SelectionChanged="OnBankSelected"
                          Height="360" />
                <TextBlock x:Name="StatusText" FontSize="20" Foreground="#FFAADDAA" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Content="Import bank" Style="{StaticResource TenFootButtonStyle}" Click="OnImport" />
            <Button Content="Clear bank" Style="{StaticResource TenFootButtonStyle}" Click="OnClearBank" />
            <Button Content="Clear all" Style="{StaticResource TenFootButtonStyle}" Click="OnClearAll" />
            <Button Content="Save image" Style="{StaticResource TenFootButtonStyle}" Click="OnSave" />
            <Button Content="Back" Style="{StaticResource TenFootButtonStyle}" Click="OnBack" />
        </StackPanel>
    </Grid>
</Page>
