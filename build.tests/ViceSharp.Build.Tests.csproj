<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PLAN-NUKETESTS-001 (TR-BUILD-001 ac-12): tests of Nuke build code live here, beside build/,
    outside ViceSharp.slnx, and run through `nuke BuildTest`. No product test project compiles
    or tests files from build/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test assembly: AOT/trim analysis does not apply. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Repository root for tests that read committed files (same idiom as ViceSharp.Library.Tests). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- The real build assembly (internal types visible through InternalsVisibleTo in _build.csproj). -->
    <ProjectReference Include="..\build\_build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
