# TR-BUILD-001 / TR-PLAT-001: generated by the Nuke PackYay target.
# Local binary payload; no AUR upload or package installation occurs during PackYay.
# Format: https://man.archlinux.org/man/PKGBUILD.5.en
pkgname=vicesharp
pkgver=@VERSION@
pkgrel=1
pkgdesc='VICE-derived Commodore emulator with an Avalonia desktop interface'
arch=('@ARCH@')
url='https://github.com/sharpninja/vice-sharp'
license=('GPL-2.0-or-later')
depends=('glibc' 'libgcc' 'libstdc++' 'icu' 'krb5' 'libunwind' 'openssl' 'zlib'
         'ca-certificates' 'tzdata' 'libx11' 'libxcursor' 'libice' 'libsm' 'fontconfig')
optdepends=('xorg-xwayland: run the X11 desktop interface in a Wayland session'
            'sdl2: Linux audio output through libSDL2-2.0.so.0 (sdl2-compat also provides it)'
            'ffmpeg: encode video captures'
            'libsecret: securely save RomM credentials with secret-tool and a Secret Service keyring')
# Stripping .NET assemblies or bundled native libraries can corrupt the payload.
options=('!strip' '!debug')
source=('@ARCHIVE@')
sha256sums=('@SHA256@')

package() {
    install -d "$pkgdir/usr/lib/vicesharp"
    cp -a "$srcdir/payload/." "$pkgdir/usr/lib/vicesharp/"
    # The installed payload is root-owned; publish-time umask must not make
    # managed assemblies, native libraries or subdirectories private to root.
    chmod -R u=rwX,go=rX "$pkgdir/usr/lib/vicesharp"
    chmod 755 "$pkgdir/usr/lib/vicesharp/ViceSharp.Avalonia"
    install -Dm755 "$srcdir/vicesharp" "$pkgdir/usr/bin/vicesharp"
    install -Dm644 "$srcdir/vicesharp.desktop" "$pkgdir/usr/share/applications/vicesharp.desktop"
    install -Dm644 "$srcdir/vicesharp.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/vicesharp.svg"
    install -Dm644 "$srcdir/COPYING" "$pkgdir/usr/share/licenses/vicesharp/COPYING"
    install -Dm644 "$srcdir/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/vicesharp/THIRD_PARTY_NOTICES.md"
}
