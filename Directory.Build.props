<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    FIX-XNTSCFPS-001: the SDK grants CUSTOM configuration names debug-ish code-gen defaults
    (Optimize=false, no TRACE). Under a VS solution build the Release-UWP config remaps every
    non-head project onto plain Release, but a CLI build of the head flows Configuration=
    Release-UWP down the P2P graph, silently producing UNOPTIMIZED emulator cores (measured
    on-device 2026-07-14: SPD 43% vs 98.6% for the same head). Release-UWP therefore means
    release code-gen for EVERY project, however it is reached.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release-UWP'">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE;RELEASE</DefineConstants>
  </PropertyGroup>


  <PropertyGroup>
    <RootNamespace>ViceSharp.$(MSBuildProjectName.Replace('ViceSharp.',''))</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Sharp Ninja</Authors>
    <Company>ViceSharp</Company>
    <Copyright>Copyright (c) 2026 ViceSharp Contributors. Licensed under GPL-2.0-or-later.</Copyright>
    <Description>ViceSharp - C# port of VICE (Versatile Commodore Emulator)</Description>
    <RepositoryUrl>https://dev.azure.com/McpServer/VICE-Sharp/_git/VICE-Sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <!-- Every NuGet package ships a README: a per-project README.md next to the
         csproj when one exists, otherwise the repository README. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <_ViceSharpPackageReadme Condition="Exists('$(MSBuildProjectDirectory)/README.md')">$(MSBuildProjectDirectory)/README.md</_ViceSharpPackageReadme>
    <_ViceSharpPackageReadme Condition="'$(_ViceSharpPackageReadme)' == ''">$(MSBuildThisFileDirectory)README.md</_ViceSharpPackageReadme>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(_ViceSharpPackageReadme)" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
