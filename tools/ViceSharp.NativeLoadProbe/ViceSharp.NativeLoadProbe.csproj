<Project Sdk="Microsoft.NET.Sdk">

  <!-- PLAN-NATIVERESTORE-001 D2 load detector: fresh-process controls (round 4 N11). The harness launches this
       console with VICESHARP_NATIVE_LOAD_LOG set to a fresh file per scenario and reads the recorded attempts.
       It references no native library build; it only exercises the managed bindings' resolve and load paths. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>ViceSharp.NativeLoadProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ViceSharp.Abstractions/ViceSharp.Abstractions.csproj" />
    <ProjectReference Include="../../src/ViceSharp.Core/ViceSharp.Core.csproj" />
  </ItemGroup>

</Project>
