# Replicated from azure-pipelines.yml (sha256:315962657A25)
$ErrorActionPreference = 'Stop'
function Invoke-External([string]$Command, [string]$FailureMessage) {
  Write-Host ">> $Command"
  cmd /c "$Command 2>&1"
  if ($LASTEXITCODE -ne 0) { throw "$FailureMessage exit $LASTEXITCODE" }
}
$srcCandidates = @('C:\\deploy\\aiUnit', 'F:\\GitHub\\aiUnit')
$src = $null; foreach ($c in $srcCandidates) { if (Test-Path $c) { $src = $c; break } }
if (-not $src) { throw "source directory not found" }
Set-Location $src
Write-Host "Working directory: $src"
Write-Host '=== Install .NET 8 SDK for Nuke ==='
Write-Host '=== Install .NET 10 SDK ==='
Invoke-External 'dotnet --info' 'step failed'
Write-Host '=== Show .NET SDK info ==='
Invoke-External './build.ps1 --target Test --configuration $(BuildConfiguration)' 'step failed'
Write-Host '=== Test (via Nuke) ==='
Write-Host '=== Publish test results ==='
Write-Host '=== Pack NuGet packages (via Nuke) ==='
Write-Host '=== Smoke test packed tools (via Nuke) ==='
Write-Host '=== Publish NuGet package artifact ==='
