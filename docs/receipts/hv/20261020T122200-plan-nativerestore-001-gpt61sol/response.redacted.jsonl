publishes\n129: # and the memory fetch timeout set below last only as long as this entry; a process that runs the entry in-process gets\n130: # both back as they were when it returns.\n131: $priorHookDeadline = $env:MCP_HOOK_DEADLINE_UTC_MS\n132: $priorMemoryTimeout = $env:MCP_MEMORY_REPL_TIMEOUT_SECONDS\n133: try {\n134:     if ('session-start' -eq 'user-prompt-submit') {\n135:         # TR-MCP-MEMORY-008 AC-002 (PLAN-SESSIONTRIAGEFIX-001 F2, triage-report-f01b3544): the request boundary adds the\n136:         # plugin's required memories to the hook output, as this entry did before 2026-10-01, keeping the hook's own fields\n137:         # and exit code. A missing helper or a failed fetch never blocks the prompt, and the fetch keeps to the hook\n138:         # deadline (TR-MCP-REPL-012 AC-001): with under one second left it is not started, otherwise its timeout is no\n139:         # longer than the whole seconds left.\n140:         $hookOutput = & $hookScript @hookArguments @RemainingArguments\n141:         $hookExit = if (Get-Variable -Name LASTEXITCODE -Scope Global -ErrorAction SilentlyContinue) { $global:LASTEXITCODE } else { 0 }\n142:         $mergedOutput = ($hookOutput | Out-String).TrimEnd()\n143:         try {\n144:             $memoryContextScript = @('hooks/scripts/memory-context.ps1', 'lib/memory-context.ps1') |\n145:                 ForEach-Object { Join-Path $pluginRoot $_ } |\n146:                 Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } |\n147:                 Select-Object -First 1\n148:             if ($memoryContextScript) {\n149:                 . $memoryContextScript\n150:                 $injectArguments = @{ HookOutput = $mergedOutput; PluginRoot = $pluginRoot }\n151:                 $hookDeadline = 0L\n152:                 if ([long]::TryParse([string]$env:MCP_HOOK_DEADLINE_UTC_MS, [ref]$hookDeadline) -and $hookDeadline -gt 0) {\n153:                     $remainingMs = $hookDeadline - [DateTimeOffset]::UtcNow.ToUnixTimeMilli