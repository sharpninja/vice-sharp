z;\n160: +        bank_start = bank_limit = 0; /* prevent caching */\n161: +        JUMP(maincpu_regs.pc);\n162: +        maincpu_jammed = 0;\n163: +        last_opcode_info = 0;\n164: +        last_opcode_addr = reg_pc;\n165: +        stolen_cycles = 0;\n166: +        check_ba_low = 0;\n167: +        reu_dma_triggered = 0;\n168: +        maincpu_rmw_flag = 0;\n169: +    } else {\n170: +        machine_trigger_reset(MACHINE_RESET_MODE_RESET_CPU);\n171: +    }\n172: +#else\n173:      machine_trigger_reset(MACHINE_RESET_MODE_RESET_CPU);\n174: +#endif\n175:  \n176:      while (1) {\n177:  #define CPU_LOG_ID maincpu_log\n178: @@ -951,11 +1002,31 @@ int maincpu_snapshot_read_module(snapshot_t *s)\n179:          || SMR_B(m, &sp) < 0\n180:          || SMR_W(m, &pc) < 0\n181:          || SMR_B(m, &status) < 0\n182: -        || SMR_DW_UINT(m, &last_opcode_info) < 0\n183: -        || SMR_DW_INT(m, &ane_log_level) < 0\n184: -        || SMR_DW_INT(m, &lxa_log_level) < 0\n185: -        || SMR_DW_INT(m, &maincpu_jammed) < 0\n186: -        || SMR_DW_INT(m, &maincpu_ba_low_flags) < 0) {\n187: +        || SMR_DW_UINT(m, &last_opcode_info) < 0) {\n188: +        goto fail;\n189: +    }\n190: +\n191: +    /* ane/lxa logging levels (snapshot module v1.3) and maincpu_jammed (v1.4,\n192: +       VICE commit 573f0f38a2 \"save 'jammed' status into snapshot\") were\n193: +       inserted between last_opcode_info and maincpu_ba_low_flags. A snapshot\n194: +       written by an older x64sc (module v1.2, e.g. a release build) lacks\n195: +       them; reading them unconditionally misaligns ba_low_flags and the\n196: +       interrupt sub-modules, raising SNAPSHOT_READ_OUT_OF_BOUNDS_ERROR. Guard\n197: +       each addition by version so externally-staged/older .vsf files resume\n198: +       cleanly while current snapshots are unaffected. ba_low_flags has existed\n199: +       since v1.2 and is always the last field before the interrupt modules. */\n200: +    if (!snapshot_version_is_smaller(maj