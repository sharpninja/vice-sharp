yte adapter for TR-VSFLOCKSTEP-RESUME-001 AC1. It does not execute,\n7: /// patch, or replace VICE. Layouts are pinned to VICE commit\n8: /// cc67418cba58e71d8e70fd353e9de47199ad2075: mainc64cpu.c:884-978,\n9: /// interrupt.c:385-419, snapshot.c:693-699/815-848, snapshot.h:112,\n10: /// and c64/c64.c:1481-1487. Existing fields are never reinterpreted.\n11: /// </summary>\n12: public static class X64ScSnapshotCompatibility\n13: {\n14:     private const int ModuleHeaderSize = 22;\n15: \n16:     /// <summary>\n17:     /// Validates an uncompressed C64SC VSF 2.0 container and its complete module\n18:     /// chain, then expands MAINCPU 1.2/1.3 to the pinned 1.4 layout. Defaults for\n19:     /// absent ANE/LXA logging and jammed state are zero, matching mainc64cpu.c.\n20:     /// Current 1.4 bytes pass through unchanged. Input is never modified.\n21:     /// </summary>\n22:     /// <param name=\"input\">Complete snapshot bytes, not a path or a module fragment.</param>\n23:     /// <returns>A separately owned validated byte array.</returns>\n24:     /// <exception cref=\"InvalidDataException\">\n25:     /// The container, module chain, machine, version, or exact CPU layout is\n26:     /// malformed or unsupported. No partially normalized output is returned.\n27:     /// </exception>\n28:     /// <remarks>\n29:     /// This byte contract does not establish native resume correctness. Native\n30:     /// fixture resume and round-trip tests remain mandatory before integration.\n31:     /// </remarks>\n32:     public static byte[] Normalize(ReadOnlySpan<byte> input)\n33:     {\n34:         if (input.Length < 37 || !input[..19].SequenceEqual(\"VICE Snapshot File\\x1a\"u8))\n35:             throw Invalid(\"Missing or truncated VSF header.\");\n36:         if (input[19] != 2 || input[20] != 0)\n37:             throw Invalid(\"Only VSF container version 2.0 is supported.\");\n38:         // x64 and x64sc have distinct CPU layouts despite the MAINCPU name.\n39:         if (!input.Slice(21, 6).SequenceEqual(\"C64SC\\0\"u8))\n40:             throw Invalid(\"Only the C64SC machine layout is supported.\");\n41: \n42:         var offset = 37;\n43:         if (input.Length >= 50 && input.Slice(37, 13).SequenceEqual(\"VICE Version\\x1a\"u8))\n44:         {\n45:             if (input.Length < 58) throw Invalid(\"Truncated VICE version header.\");\n46:             offset = 58;\n47:         }\n48: \n49:         var cpuOffset = -1;\n50:         var cpuSize = 0;\n51:         byte cpuMinor = 0;\n52:         while (offset < input.Length)\n53:         {\n54:             var remaining = input.Length - offset;\n55:             if (remaining < ModuleHeaderSize) throw Invalid(\"Truncated module header.\");\n56:             var size = BinaryPrimitives.ReadUInt32LittleEndian(input.Slice(offset + 18, 4));\n57:             // Compare unsigned declared lengths before conversion or addition.\n58:             if (size < ModuleHeaderSize || size > (uint)remaining)\n59:                 throw Invalid(\"Module length is outside the snapshot boundary.\");\n60:             if (input.Slice(offset, 8).SequenceEqual(\"MAINCPU\\0\"u8))\n61:             {\n62:                 if (cpuOffset >= 0) throw Invalid(\"Duplicate MAINCPU module.\");\n63:                 cpuMinor = input[offset + 17];\n64:                 if (input[offset + 16] != 1 || cpuMinor is < 2 or > 4)\n65:                     throw Invalid(\"Unsupported MAINCPU version.\");\n66:                 var expectedPayload = cpuMinor switch { 2 => 91, 3 => 99, _ => 103 };\n67:                 if (size != ModuleHeaderSize + expectedPayload)\n68:                     throw Invalid(\"MAINCPU payload does not match its pinned layout.\");\n69:                 cpuOffset = offset;\n70:                 cpuSize = (int)size;\n71:             }\n72:             offset += (int)size;\n73:         }\n74:         if (cpuOffset < 0) throw Invalid(\"Missing MAINCPU module.\");\n75: \n76:         // Do not return even an unchanged 1.4 copy until all later modules pass.\n77:         if (cpuMinor == 4) return input.ToArray();\n78:         var growth = cpuMinor == 2 ? 12 : 4;\n79:         if (input.Length > int.MaxValue - growth) throw Invalid(\"Snapshot is too large.\");\n80:         var insertion = cpuOffset + ModuleHeaderSize + (cpuMinor == 2 ? 19 : 27);\n81:         var output = new byte[input.Length + growth];\n82:         input[..insertion].CopyTo(output);\n83:         input[insertion..].CopyTo(output.AsSpan(insertion + growth));\n84:         // The newly allocated gap contains precisely the missing zero defaults.\n85:         output[cpuOffset + 17] = 4;\n86:         BinaryPrimitives.WriteUInt32LittleEndian(output.AsSpan(cpuOffset + 18, 4),\n87:             (uint)(cpuSize + growth));\n88:         return output;\n89:     }\n90: \n91:     private static InvalidDataException Invalid(string message) => new(message);\n92: }\nrg: tests/ViceSharp.TestHarness/SnapshotResumeTests.cs: No such file or directory (os error 2)\nrg: tests/ViceSharp.TestHarness/Vic20SnapshotRoundTripTests.cs: No such file or directory (os error 2)\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:192:        var native = ViceNativeBridge.CreateMachine(modelSelector);\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:198:            ViceNativeBridge.ResetMachine(native);\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:219:            ViceNativeBridge.DestroyMachine(native);\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:314:        ViceNativeBridge.SetKeyboardMatrixKey(native, row, column, pressed);\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:331:        ViceNativeBridge.StoreCia1Register(native, 0x02, 0x00);\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:332:        ViceNativeBridge.StoreCia1Register(native, 0x03, 0xFF);\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:333:        ViceNativeBridge.StoreCia1Register(native, 0x01, columnMask);\ntests/ViceSharp.TestHarness/C64VkmKeyboardTests.cs:336:      