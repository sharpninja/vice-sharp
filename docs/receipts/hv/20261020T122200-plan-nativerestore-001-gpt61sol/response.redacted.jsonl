TEST bit pulse to zero the accumulator,\n34:     /// then freq=0x1000 for exactly 1000 exact cycles, the oracle state reports\n35:     /// accumulator == (0x1000 * 1000) &amp; 0xFFFFFF and OSC3 == accumulator &gt;&gt; 16\n36:     /// (bit-exact, no tolerance).\n37:     /// </summary>\n38:     [ViceFact]\n39:     public void ExactClock_AccumulatorFollowsClosedForm()\n40:     {\n41:         var native = ViceNativeBridge.CreateMachine(\"c64\");\n42:         try\n43:         {\n44:             Assert.True(ViceNativeBridge.SidExactOpen(native), \"exact oracle failed to open\");\n45:             ViceNativeBridge.SidExactReset(native);\n46: \n47:             // Hold the accumulator at zero via the TEST bit, then release and count.\n48:             ViceNativeBridge.SidExactWrite(native, FreqLoV3, 0x00);\n49:             ViceNativeBridge.SidExactWrite(native, FreqHiV3, 0x10); // freq = 0x1000\n50:             ViceNativeBridge.SidExactWrite(native, ControlV3, 0x28); // TEST | SAW\n51:             ViceNativeBridge.SidExactClock(native, 8);\n52:             ViceNativeBridge.SidExactWrite(native, ControlV3, 0x20); // SAW, TEST released\n53: \n54:             ViceNativeBridge.SidExactClock(native, 1000);\n55: \n56:             var state = ViceNativeBridge.SidExactGetState(native);\n57:             uint expected = (0x1000u * 1000u) & 0xFFFFFF;\n58:             Assert.Equal(expected, state.GetAccumulators()[2]);\n59:             Assert.Equal((byte)(expected >> 16), ViceNativeBridge.SidExactRead(native, Osc3));\n60:         }\n61:         finally\n62:         {\n63:             ViceNativeBridge.DestroyMachine(native);\n64:         }\n65:     }\n66: \n67:     /// <summary>\n68:     /// FR: FR-SID-ENV, TR: TR-SID-ORACLE-001, TEST: TEST-SID-ORACLE-P0-02.\n69:     /// Use case: envelope ACs need the oracle to reproduce reSID's single-cycle\n70:     /// envelope pipeline; the batched clock(delta_t) path steps the envelope at\n71:     /// rate_period cycles and loses the pipeline delay.\n72:     /// Acceptance: voice 3 in steady ATTACK with attack=4 (rate_counter_period\n73:     /// 148 per resid/envelope.cc) increments ENV3 every rate_period + 1 = 149\n74:     /// cycles exactly (single-cycle trace: counter reaches 148, one reset/arm\n75:     /// cycle, two envelope_pipeline cycles overlapping the next count).\n76:     /// </summary>\n77:     [ViceFact]\n78:     public void ExactClock_AttackStepSpacing_MatchesSingleCyclePipeline()\n79:     {\n80:         var native = ViceNativeBridge.CreateMachine(\"c64\");\n81:         try\n82:         {\n83:             Assert.True(ViceNativeBridge.SidExactOpen(native), \"exact oracle failed to open\");\n84:             ViceNativeBridge.SidExactReset(native);\n85: \n86:             ViceNativeBridge.SidExactWrite(native, AttackDecayV3, 0x40); // attack=4 -> period 148\n87:             ViceNativeBridge.SidExactWrite(native, SustainReleaseV3, 0x00);\n88:             ViceNativeBridge.SidExactWrite(native, ControlV3, 0x01); // gate on\n89: \n90:             var increments = new List<int>();\n91:             byte previous = ViceNativeBridge.SidExactGetState(native).GetEnvelopeCounters()[2];\n92:             for (int cycle = 1; cycle <= 1200 && increments.Count < 5; cycle++)\n93:             {\n94:                 ViceNativeBridge.SidExactClock(native, 1);\n95:                 byte current = ViceNativeBridge.SidExactGetState(native).GetEnvelopeCounters()[2];\n96:                 if (current != previous)\n97:                 {\n98:                     increments.Add(cycle);\n99:                     previous = current;\n100:                 }\n101:             }\n102: \n103:             Assert.True(increments.Count >= 4, $\"expected at least 4 envelope steps, saw {increments.Count}\");\n104:             // Steady-state spacing (skip the gate-on transient before the first step).\n105:             for (int i = 2; i < increments.Count; i++)\n106:             {\n107:                 Assert.Equal(149, increments[i] - increments[i - 1]);\n108:             }\n109:         }\n110:         finally\n111:         {\n112:             ViceNativeBridge.DestroyMachine(native);\n113:         }\n114:     }\n115: \n116:     /// <summary>\n117:     /// FR: FR-SID-CLOCK, TR: TR-SID-ORACLE-001, TEST: TEST-SID-ORACLE-P0-03.\n118:     /// Use case: every parity AC assumes the oracle is a pure deterministic\n119:     /// function of its register program; two identical programs must yield\n120:     /// identical internal state.\n121:     /// Acceptance: two independently created machines running the same\n122:     /// reset/write/clock sequence report byte-identical vice_sid_exact_state\n123:     /// structs (full struct memory compare, delta 0).\n124:     /// </summary>\n125:     [ViceFact]\nFILE: tests/ViceSharp.TestHarness/NativeCollectionConventionTests.cs (113 lines)\n1: using System;\n2: using System.Collections.Generic;\n3: using System.IO;\n4: using System.Linq;\n5: using System.Text.RegularExpressions;\n6: using Xunit;\n7: \n8: namespace ViceSharp.TestHarness;\n9: \n10: /// <summary>\n11: /// Convention ratchet: every xUnit test class that drives the native VICE\n12: /// bridge (reSID/x64sc oracle) must join the <c>NativeVice</c> collection so\n13: /// xUnit serializes it. Native VICE is a process-global, non-reentrant shim;\n14: /// two native test classes running in parallel corrupt each other's oracle\n15: /// state. The assembly currently disables all parallelization, but that is a\n16: /// blunt safety net: this convention makes the requirement explicit and\n17: /// survives any future re-enable of parallel collections.\n18: ///\n19: /// Exemptions are structural, not a filename allow-list:\n20: ///   - non-test-class native users (shared helpers like LockstepValidator, the\n21: ///     ViceMachineValidationFixture) carry no test-method attribute, so the\n22: ///     \"is a test class\" gate skips them;\n23: ///   - files whose only ViceFact/ViceTheory occurrences are inside doc comments\n24: ///     or regex string literals (XmlDocsConventionTests) are not matched,\n25: ///     because the native-attribute probe only accepts a real attribute at the\n26: ///     start of a line.\n27: /// </summary>\n28: public sealed class NativeCollectionConventionTests\n29: {\n30:     // A real [ViceFact]/[ViceTheory] attribute at the start of a line (not a\n31:     // doc-comment mention or a string literal).\n32:     private static readonly Regex NativeAttribute = new(\n33:         @\"^[ \\t]*\\[\\s*(?:ViceFact|ViceTheory)(?:Attribute)?\\b\",\n34:         RegexOptions.Multiline | RegexOptions.Compiled);\n35: \n36:     // Any xUnit test-method attribute at the start of a line (proves the file is\n37:     // an executable test class rather than a helper or fixture).\n38:     private static readonly Regex TestMethodAttribute = new(\n39:         @\"^[ \\t]*\\[\\s*(?:Fact|Theory|ViceFact|ViceTheory)(?:Attribute)?\\b\",\n40:         RegexOptions.Multiline | RegexOptions.Compiled);\n41: \n42:     // Direct native-bridge entry points. A file that instantiates the native\n43:     // machine any other way is out of scope for this convention.\n44:     private static readonly string[] NativeBridgeMarkers =\n45:     {\n46:         \"ViceNative.CreateInstance\",\n47:         \"ViceNativeBridge.CreateMachine\",\n48:     };\n49: \n50:     /// <summary>\n51:     /// FR: FR-QA-NATIVE-COLLECTION, TR: TR-QA-NATIVE-COLLECTION-CONVENTION.\n52:     /// Use case: continuous-integration guard that every native-bridge test\n53:     /// class is serialized under the NativeVice collection, so a future\n54:     /// re-enable of parallel collections cannot race the process-global oracle.\n55:     /// Acceptance: no test class in the harness drives the native VICE bridge\n56:     /// without declaring [Collection(\"NativeVice\")].\n57:     /// </summary>\n58:     [Fact]\n59:     public void NativeBridgeTestClasses_DeclareNativeViceCollection()\n60:     {\n61:         var sourceDirectory = ResolveSourceDirectory();\n62:         var violations = new List<string>();\n63: \n64:         foreach (var file in Directory.EnumerateFiles(sourceDirectory, \"*.cs\", SearchOption.AllDirectories))\n65:         {\n66:             var normalized = file.Replace('\\\\', '/');\n67:             if (normalized.Contains(\"/bin/\", StringComparison.Ordinal)\n68:                 || normalized.Contains(\"/obj/\", StringComparison.Ordinal))\n69:                 continue;\n70: \n71:             // The convention test cites the markers in its own source; skip it.\n72:             if (Path.GetFileName(file).Equals(\n73:                     typeof(NativeCollectionConventionTests).Name + \".cs\",\n74:                     StringComparison.OrdinalIgnoreCase))\n75:                 continue;\n76: \n77:             var contents = File.ReadAllText(file);\n78: \n79:             var usesNative =\n80:                 NativeAttribute.IsMatch(contents)\n81:                 || NativeBridgeMarkers.Any(m => contents.Contains(m, StringComparison.Ordinal));\n82:             if (!usesNative)\n83:                 continue;\n84: \n85:             if (!TestMethodAttribute.IsMatch(contents))\n86:                 continue; // helper / fixture, not an executable test class.\n87: \n88:             if (!contents.Contains(\"Collection(\\\"NativeVice\\\")\", StringComparison.Ordinal))\n89:                 violations.Add(Path.GetRelativePath(sourceDirectory, file).Replace('\\\\', '/'));\n90:         }\n91: \n92:         violations.Sort(StringComparer.Ordinal);\n93:         Assert.True(\n94:             violations.Count == 0,\n95:             \"Native-bridge test classes missing [Collection(\\\"NativeVice\\\")]:\"\n96:             + Environment.NewLine\n97:             + string.Join(Environment.NewLine, violations.Select(v => \"  - \" + v)));\n98:     }\n99: \n100:     private static string ResolveSourceDirectory()\n101:     {\n102:         var current = new DirectoryInfo(AppContext.BaseDirectory);\n103:         while (current is not null)\n104:         {\n105:             if (File.Exists(Path.Combine(current.FullName, \"ViceSharp.TestHarness.csproj\")))\n106:                 return current.FullName;\n107:             current = current.Parent;\n108:         }\n109: \n110:         throw new InvalidOperationException(\n111:             \"Unable to resolve ViceSharp.TestHarness source directory for the native-collection scan.\");\n112:     }\n113: }\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:18:public sealed class NativeResidueDiagTests\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:138:        var scratch = ViceNativeBridge.CreateMachine(\"c64\");\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:141:            Assert.True(ViceNativeBridge.SetDriveCycleAccum(scratch, Unit8, Poison) == 0,\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:144:            Assert.Equal(Poison, ViceNativeBridge.GetDriveCycleAccum(scratch, Unit8));\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:148:            ViceNativeBridge.DestroyMachine(scratch);\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:151:        var check = ViceNativeBridge.CreateMachine(\"c64\");\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:154:            var residue = ViceNativeBridge.GetDriveCycleAccum(check, Unit8);\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:160:            ViceNativeBridge.DestroyMachine(check);\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:185:        var scratch = ViceNativeBridge.CreateMachine(\"c64\");\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:188:            ViceNativeBridge.ResetMachine(scratch);\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:191:                ViceNativeBridge.StepCycle(scratch);\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:192:            ViceNativeBridge.AttachDisk(scratch, Unit8, 0, DiskFixture);\ntests/ViceSharp.TestHarness/NativeResidueDiagTests.cs:193:            _ = ViceNativeBr