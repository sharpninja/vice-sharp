 Copy-stage list: it must be unchanged.\n17: Every native tool (sh, autoreconf, configure, make, gcc, nm) runs through the platform shell: /bin/sh on\n18: Linux, and on Windows the MSYS2 MINGW64 login shell (Payton directive 2026-10-20T08:07: \"always use msys\n19: to compile native VICE code\"), never gcc.exe called directly. Nothing under native/vice or the\n20: materialization source is modified; generated files live only in the work, build, bin and receipts trees\n21: under artifacts/immutable-vice/<sha>/ (gitignored).\n22: \n23: .PARAMETER Stage\n24: One of Copy, Autogen, Configure, Make, Link, Inventory, All.\n25: #>\n26: [CmdletBinding()]\n27: param(\n28:     [ValidateSet('Copy', 'Autogen', 'Configure', 'Make', 'Link', 'Inventory', 'All')]\n29:     [string] $Stage = 'All',\n30:     [ValidateSet('x64sc', 'xvic', 'both')]\n31:     [string] $Machine = 'both',\n32:     [string] $Sha = 'cc67418cba58e71d8e70fd353e9de47199ad2075',\n33:     [string] $RepoRoot = (Split-Path -Parent $PSScriptRoot),\n34:     [int] $Jobs = [Environment]::ProcessorCount,\n35:     [string] $MsysRoot = 'C:\\msys64'\n36: )\n37: Set-StrictMode -Version Latest\n38: $ErrorActionPreference = 'Stop'\n39: \n40: $script:machineChoice = $Machine\n41: $script:jobCount = $Jobs\n42: $script:msysRootPath = $MsysRoot\n43: $hostTag = if ($IsWindows) { 'windows' } else { 'linux' }\n44: $exeExt = if ($IsWindows) { '.exe' } else { '' }\n45: $root = Join-Path $RepoRoot \"artifacts/immutable-vice/$Sha\"\n46: $source = Join-Path $root 'source/vice'\n47: $work = Join-Path $root \"work-$hostTag/vice\"\n48: $build = Join-Path $root \"build-$hostTag\"\n49: $bin = Join-Path $root \"bin-$hostTag\"\n50: $receipts = Join-Path $root \"receipts-$hostTag\"\n51: $wrappers = Join-Path $RepoRoot 'tools/immutable-vice'\n52: foreach ($dir in @($build, $bin, $receipts)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }\n53: if (-not (Test-Path -LiteralPath $source)) { throw \"Materialization source missing: $source\" }\n54: \n55: # Lab rule (Payton 2026-10-20T08:19): forward slashes on Windows for every path handed to the shell (C:/...).\n56: function ConvertTo-ShellPath {\n57:     param([Parameter(Mandatory)][string] $Path)\n58:     if (-not $IsWindows) { return $Path }\n59:     return ([IO.Path]::GetFullPath($Path) -replace '\\\\', '/')\n60: }\n61: \n62: # Paths handed to the autotools scripts must be MSYS POSIX form (/f/GitHub/...): the generated configure splits\n63: # its aux-dir candidates on \":\" (configure 3490 and 3500 to 3502 under IFS=$PATH_SEPARATOR) and the generated\n64: # Makefiles carry srcdir and VPATH, so a drive colon breaks both (LEGION2 finding 2026-10-20T10:13). Forward\n65: # slashes throughout, per the lab rule; gcc arguments keep the C:/ form, which native gcc understands.\n66: function ConvertTo-PosixPath {\n67:     param([Parameter(Mandatory)][string] $Path)\n68:     $forward = ConvertTo-ShellPath $Path\n69:     if ($IsWindows -and $forward -match '^([A-Za-z]):/(.*)$') { return ('/{0}/{1}' -f $Matches[1].ToLowerInvariant(), $Matches[2]) }\n70:     return $forward\n71: }\n72: \n73: function Get-TreeHashList {\n74:     param([Parameter(Mandatory)][string] $Root)\n75:     $prefix = (Resolve-Path -LiteralPath $Root).Path.TrimEnd('/', '\\') + [IO.Path]::DirectorySeparatorChar\n76:     Get-ChildItem -LiteralPath $Root -Recurse -Force -File |\n77:         ForEach-Object {\n78:             [pscustomobject]@{\n79:                 Path = $_.FullName.Substring($prefix.Length).Replace('\\', '/')\n80:                 Sha256 = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash\n81:             }\n82:         } | Sort-Object -Property Path -Culture ([cultureinfo]::InvariantCulture)\n83: }\n84: \n85: function Write-Receipt {\n86:     param([Parameter(Mandatory)][string] $Name, [Parameter(Mandatory)] $Object)\n87:     $path = Join-Path $receipts (\"{0}-{1}.json\" -f (Get-Date -Format 'yyyyMMddTHHmmss'), $Name)\n88:     $Object | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $path -Encoding utf8\n89:     Write-Output \"receipt: $path\"\n90:     return $path\n91: }\n92: \n93: # Runs one shell command line through the platform shell and logs command, cwd, exit and both streams.\n94: function Invoke-Native {\n95:     param(\n96:         [Parameter(Mandatory)][string] $Command,\n97:         [Parameter(Mandatory)][string] $WorkingDirectory,\n98:         [Parameter(Mandatory)][string] $LogPath\n99:     )\n100:     $psi = [System.Diagnostics.ProcessStartInfo]::new()\n101:     if ($IsWindows) {\n102:         # Lab rule (Payton 2026-10-20T08:19): forward slashes on Windows.\n103:         $psi.FileName = ($script:msysRootPath -replace '\\\\', '/').TrimEnd('/') + '/usr/bin/bash.exe'\n104:         [void]$psi.ArgumentList.Add('-lc')\n105:         [void]$psi.ArgumentList.Add($Command)\n106:         $psi.Environment['MSYSTEM'] = 'MINGW64'\n107:         $psi.Environment['CHERE_INVOKING'] = '1'\n108:         $psi.Environment['MSYS2_PATH_TYPE'] = 'minimal'\n109:     } else {\n110:         $psi.FileName = '/bin/sh'\n111:         [void]$psi.ArgumentList.Add('-c')\n112:         [void]$psi.ArgumentList.Add($Command)\n113:     }\n114:     $psi.WorkingDirectory = $WorkingDirectory\n115:     $psi.UseShellExecute = $false\n116:     $psi.RedirectStandardOutput = $true\n117:     $psi.RedirectStandardError = $true\n118:     $p = [System.Diagnostics.Process]::Start($psi)\n119:     $stdout = $p.StandardOutput.ReadToEndAsync()\n120:     $stderr = $p.StandardError.ReadToEndAsync()\n121:     $p.WaitForExit()\n122:     $text = \"SHELL: {0}`nCOMMAND: {1}`nCWD: {2}`nEXIT: {3}`n--- STDOUT`n{4}`n--- STDERR`n{5}\" -f $psi.FileName, $Command, $WorkingDirectory, $p.ExitCode, $stdout.Result, $stderr.Result\n123:     Set-Content -LiteralPath $LogPath -Value $text -Encoding utf8\n124:     return [pscustomobject]@{ ExitCode = $p.ExitCode; Stdout = $stdout.Result; Stderr = $stderr.Result; Log = $LogPath }\n125: }\n126: \n127: # The copy set is the committed tracked-file list of the materialization (3,847 entries, SHA256|size|path,\n128: # proven byte-identical on both hosts, docs/receipts/native-vice/20261019T202542-linux-materialization/compare/),\n129: # restricted to the vice/ subtree: on PAYTON-LEGION2 the materialization is configured and built in place, so a\n130: # whole-folder copy would carry config.status into the work tree and the generated configure refuses an\n131: # out-of-tree build when $srcdir/config.status exists (LEGION2 finding 2026-10-20T10:08). Every copied file is\n132: # verified against the list's SHA256; a work tree that already holds config.status is refused, never cleaned.\n133: $script:trackedListPath = Join-Path $RepoRoot 'docs/receipts/native-vice/20261019T202542-linux-materialization/compare/omarchy-tracked-files.txt'\n134: \n135: function Get-TrackedViceList {\n136:     if (-not (Test-Path -LiteralPath $script:trackedListPath)) { throw \"Tracked-file list missing: $script:trackedListPath\" }\n137:     $entries = foreach ($line in Get-Content -LiteralPath $script:trackedListPath) {\n138:         if ([string]::IsNullOrWhiteSpace($line)) { continue }\n139:         $sha, $size, $path = $line -split '\\|', 3\n140:         if ($path.StartsWith('vice/')) { [pscustomobject]@{ Sha256 = $sha.ToUpperInvariant(); Size = [long]$size; Path = $path.Substring(5) } }\n141:     }\n142:     return @($entries | Sort-Object -Property Path -Culture ([cultureinfo]::InvariantCulture))\n143: }\n144: \n145: function Step-Copy {\n146:     $tracked = Get-TrackedViceList\n147:     if (Test-Path -LiteralPath (Join-Path $work 'config.status')) {\n148:         throw \"Work tree $work holds config.status (an in-tree configure); the out-of-tree configure would refuse it. Remove or rename the work tree (operator decision), then rerun Copy.\"\n149:     }\n150:     New-Item -ItemType Directory -Force -Path $work | Out-Null\n151:     $copied = 0\n152:     $missingSource = @()\n153:     $different = @()\n154:     foreach ($e in $tracked) {\n155:         $src = Join-Path $source $e.Path\n156:         $dst = Join-Path $work $e.Path\n157:         if (-not (Test-Path -LiteralPath $src)) { $missingSource += $e.Path; continue }\n158:         if (-not (Test-Path -LiteralPath $dst)) {\n159:             New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst) | Out-Null\n160:             Copy-Item -LiteralPath $src -Destination $dst -Force\n161:             $copied++\n162:         }\n163:         $hash = (Get-FileHash -LiteralPath $dst -Algorithm SHA256).Hash\n164:         if ($hash -ne $e.Sha256) { $different += $e.Path }\n165:     }\n166:     $listText = ($tracked | ForEach-Object { \"{0} {1}\" -f $_.Sha256, $_.Path }) -join \"`n\"\n167:     $listSha = (Get-FileHash -InputStream ([IO.MemoryStream]::new([Text.Encoding]::UTF8.GetBytes($listText))) -Algorithm SHA256).Hash\n168:     $sourceListPath = Join-Path $receipts 'materialization-hashes.txt'\n169:     Set-Content -LiteralPath $sourceListPath -Value $listText -Encoding utf8\n170:     $result = [pscustomobject]@{\n171:         Stage = 'Copy'; TrackedViceFiles = $tracked.Count; CopiedNow = $copied; TrackedList = $script:trackedListPath\n172:         MissingInSource = $missingSource; DifferentInWork = $different; SourceListSha256 = $listSha; SourceListPath = $sourceListPath\n173:     }\n174:     Write-Receipt -Name 'copy' -Object $result | Out-Null\n175:     if ($missingSource.Count -or $different.Count) { throw \"Work tree does not match the tracked list ($($missingSource.Count) missing in the materialization, $($different.Count) different in the work tree).\" }\n176:     Write-Output (\"copy verified: {0} tracked vice/ files ({1} copied now), list SHA256 {2}\" -f $tracked.Count, $copied, $listSha)\n177: }\n178: \n179: function Step-Autogen {\n180:     $log = Join-Path $receipts 'autogen.log'\n181:     $r = Invoke-Native -Command './autogen.sh' -WorkingDirectory $work -LogPath $log\n182:     Write-Receipt -Name 'autogen' -Object ([pscustomobject]@{ Stage = 'Autogen'; ExitCode = $r.ExitCode; Log = $log; ConfigureExists = (Test-Path (Join-Path $work 'configure')) }) | Out-Null\n183:     if ($r.ExitCode -ne 0 -or -not (Test-Path (Join-Path $work 'configure'))) { throw \"autogen failed (exit $($r.ExitCode)); see $log\" }\n184:     Write-Output 'autogen ok'\n185: }\n186: \n187: function Step-Configure {\n188:     $log = Join-Path $receipts 'configure.log'\n189:     $flags = @(\n190:         '--enable-headlessui', '--disable-pdf-docs', '--disable-html-docs',\n191:         '--without-pulse', '--without-alsa', '--without-oss', '--without-portaudio',\n192:         '--without-flac', '--without-vorbis', '--without-mpg123', '--without-gif', '--without-lame',\n193:         '--disable-ethernet', '--disable-realdevice', '--disable-x64', '--disable-x64-image'\n194:     )\n195:     $configurePath = ConvertTo-PosixPath (Join-Path $work 'configure')\n196:     if ($configurePath.Contains(':')) { throw \"configure path must not contain a drive colon (autotools split on it): $configurePath\" }\n197:     $command = ('\"{0}\" {1}' -f $configurePath, ($flags -join ' '))\n198:     $r = Invoke-Native -Command $command -WorkingDirectory $build -LogPath $log\n199:     Write-Receipt -Name 'configure' -Object ([pscustomobject]@{ Stage = 'Configure'; ExitCode = $r.ExitCode; Command = $command; Log = $log }) | Out-Null\n200:     if ($r.ExitCode -ne 0) { throw \"configure failed (exit $($r.ExitCode)); see $log\" }\n201:     Write-Output 'configure ok'\n202: }\n203: \n204: function Get-TargetList {\n205:     switch ($script:machineChoice) { 'both' { @('x64sc', 'xvic') } default { @($script:machineChoice) } }\n206: }\n207: \n208: function Step-Make {\n209:     $log = Join-Path $receipts 'make.log'\n210:     $targets = Get-TargetList\n211:     $programs = @($targets | ForEach-Object { $_ + $exeExt })\n212:     # The per-program targets do not depend on the bundled libraries under src/lib (liblinenoiseng.a is\n213:     # only built by the lib subdirectory recursion), so build src/lib first. Two library recipes recurse\n214:     # (\"all\") over other libraries' directories: archdep_lib (arch/shared) over hwsiddrv, mididrv, socketdrv\n215:     # and sounddrv, and core_lib (core) over rtc; under -j the program build enters those directories twice\n216:     # and the second make's \".Tpo to .Po\" move fails (LEGION2 finding 2026-10-20T10:21, soundwmm.o). Build\n217:     # those two parents before the programs so their archives exist and the recipes do not recurse again.\n218:     $command = ('make -C src/lib -j{0} V=1 && make -C src/arch/shared -j{0} V=1 && make -C src/core -j{0} V=1 && make -C src -j{0} V=1 {1}' -f $script:jobCount, ($programs -join ' '))\n219:     $r = Invoke-Native -Command $command -WorkingDirectory $build -LogPath $log\n220:     $lines = ($r.Stdout -split \"`n\")\n221:     $linkLines = @{}\n222:     foreach ($t in $targets) {\n223:         $program = [regex]::Escape($t + $exeExt)\n224:         $hit = @($lines | Where-Object { $_ -match \"\\s-o\\s+$program(\\s|$)\" -and $_ -notmatch '^\\s*(libtool|ar\\s)' }) | Select-Object -Last 1\n225:         if ($hit) { $linkLines[$t] = $hit.Trim() }\n226:     }\n227:     $linkPath = Join-Path $receipts 'stock-link-lines.json'\n228:     $linkLines | ConvertTo-Json | Set-Content -LiteralPath $linkPath -Encoding utf8\n229:     Write-Receipt -Name 'make' -Object ([pscustomobject]@{ Stage = 'Make'; ExitCode = $r.ExitCode; Command = $command; LinkLinesFound = @($linkLines.Keys); Log = $log; LinkLines = $linkPath }) | Out-Null\n230:     if ($r.ExitCode -ne 0) { throw \"make failed (exit $($r.ExitCode)); see $log\" }\nrg: docs/Project/TEST-Requirements.md: No such file or directory (os error 2)\nrg: docs/Project/TR-Requirements.md: No such file or directory (os error 2)\ndocs/Project/Requirements-Matrix.md:123:| TR-CYCLE-001 | Tracked | Technical-Requirements.md |\ndocs/Project/Requirements-Matrix.md:270:| FR-VICE-001 | Tracked | Functional-