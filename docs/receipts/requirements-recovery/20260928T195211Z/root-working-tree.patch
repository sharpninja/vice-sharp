+                    $"taken BNE after LDA abs should be 3-CLK (dummy); DebugCycle={cpu.DebugCycle} PC=${cpu.PC:X4} A=${cpu.A:X2}");
+            }
+
+            if (cpu.DebugOpcode == 0xD0 && cpu.DebugCycle == 1)
+                dummyPc = cpu.PC;
+
+            if (cpu.DebugOpcode == 0xD0 && cpu.DebugCycle == 0)
+                break;
+        }
