+        memory[0xFFFC] = 0x00;
+        memory[0xFFFD] = 0x80;
+        memory[0x8000] = 0xA5; // LDA $10
+        memory[0x8001] = 0x10;
+        memory[0x8002] = 0x85; // STA $11
+        memory[0x8003] = 0x11;
+        memory[0x8004] = 0x8D; // STA $0400
+        memory[0x8005] = 0x00;
+        memory[0x8006] = 0x04;
+        memory[0x8007] = 0xF0; // BEQ $8000
+        memory[0x8008] = 0xF7;
+        memory[0x0010] = 0x00;
