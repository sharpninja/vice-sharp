+        Assert.Equal((byte)0xD0, cpu.DebugOpcode);
+        Assert.Equal(2, cpu.DebugCycle);
+        Assert.Equal((ushort)0x8119, cpu.DebugOpcodeAddress);
+
+        stealer.IsCpuCycleStolen = true;
+        for (var i = 0; i < 14; i++)
+            clock.Step();
+
+        Assert.Equal(2, cpu.DebugCycle);
+        Assert.Equal((ushort)0x8119, cpu.DebugOpcodeAddress);
+
+        stealer.IsCpuCycleStolen = false;
+        clock.Step();
+        Assert.Equal((byte)0xD0, cpu.DebugOpcode);
+        Assert.Equal(2, cpu.DebugCycle);
+        Assert.Equal((ushort)0x8119, cpu.DebugOpcodeAddress);
