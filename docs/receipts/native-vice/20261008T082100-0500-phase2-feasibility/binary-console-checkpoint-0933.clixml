        <S N="Key">functions</S>
        <Obj N="Value" RefId="22983">
          <TNRef RefId="1" />
          <DCT>
            <En>
              <S N="Key">Invoke-Phase2FullSuite</S>
              <S N="Value">param([string]$Project, [string]$Name)_x000D__x000A__x000A_ $before = Get-PhaseNativeState -ReceiptPath (Join-Path $script:phase2Root ($Name+'-native-before.json'))_x000A_ foreach ($field in @('gitlink','head','trackedDiffSha256','untrackedListSha256','inventorySha256','newestSourceWriteUtc','fileCount','untrackedCount')) { if ($before.$field -cne $script:phaseBaseline.$field) { throw "Native preflight mismatch: $field" } }_x000A_ $results = Join-Path $script:phase2Root $Name_x000A_ New-Item -ItemType Directory -Path $results -Force | Out-Null_x000A_ dotnet test $Project -c Release --logger "trx;LogFileName=$Name.trx" --results-directory $results --diag (Join-Path $results ($Name+'.diag.log')) --blame-hang --blame-hang-timeout 2m 2&gt;&amp;1 | Tee-Object -FilePath (Join-Path $results ($Name+'.log'))_x000A_ $exitCode=$LASTEXITCODE_x000A_ $after = Get-PhaseNativeState -ReceiptPath (Join-Path $script:phase2Root ($Name+'-native-after.json'))_x000A_ foreach ($field in @('gitlink','head','trackedDiffSha256','untrackedListSha256','inventorySha256','newestSourceWriteUtc','fileCount','untrackedCount')) { if ($after.$field -cne $before.$field) { throw "Native postflight mismatch: $field" } }_x000A_ [xml]$trx = Get-Content -LiteralPath (Join-Path $results ($Name+'.trx')) -Raw_x000A_ $c=$trx.TestRun.ResultSummary.Counters_x000A_ $receipt=[ordered]@{timestampLocal=(Get-Date -Format o);project=$Project;command="dotnet test $Project -c Release --logger trx;LogFileName=$Name.trx --results-directory $results --diag $results\$Name.diag.log --blame-hang --blame-hang-timeout 2m";filter=$null;exitCode=$exitCode;total=[int]$c.total;executed=[int]$c.executed;passed=[int]$c.passed;failed=[int]$c.failed;notExecuted=[int]$c.notExecuted;aborted=[int]$c.aborted;error=[int]$c.error;timeout=[int]$c.timeout;nativeUnchanged=$true;cleanSourceStatus=@(git -C $script:phase2Source status --porcelain=v1 --untracked-files=all);scope='Native-safe byte contracts only, no native resume or parity claim'}_x000A_ $receipt | ConvertTo-Json -Depth 4 | Out-File -LiteralPath (Join-Path $results 'result.json') -Encoding utf8_x000A_ $receipt | ConvertTo-Json -Depth 4_x000A_ if ($exitCode -ne 0 -or $c.passed -ne $c.total) { throw 'Full suite not green; phase may not advance.' }_x000A_</S>
            </En>
            <En>
              <S N="Key">Invoke-Phase2CodeVerify</S>
              <S N="Value">param([string]$SourceFile, [string]$Name)_x000D__x000A__x000A_ $before = Get-PhaseNativeState -ReceiptPath (Join-Path $script:phase2Root ($Name + '-native-before.json'))_x000A_ foreach ($field in @('gitlink','head','trackedDiffSha256','untrackedListSha256','inventorySha256','newestSourceWriteUtc','fileCount','untrackedCount')) { if ($before.$field -cne $script:phaseBaseline.$field) { throw "Native preflight mismatch: $field" } }_x000A_ $payload = @{tool_name='Edit';tool_input=@{file_path=$SourceFile}} | ConvertTo-Json -Compress_x000A_ &amp; (Join-Path $script:hvOverridePluginRoot 'lib\code-verify.ps1') -Params $payload_x000A_ if (Test-Path -LiteralPath (Join-Path $script:hvOverrideCache 'last-build.log')) { Copy-Item -LiteralPath (Join-Path $script:hvOverrideCache 'last-build.log') -Destination (Join-Path $script:phase2Root ($Name + '-build.log')) }_x000A_ $after = Get-PhaseNativeState -ReceiptPath (Join-Path $script:phase2Root ($Name + '-native-after.json'))_x000A_ foreach ($field in @('gitlink','head','trackedDiffSha256','untrackedListSha256','inventorySha256','newestSourceWriteUtc','fileCount','untrackedCount')) { if ($after.$field -cne $before.$field) { throw "Native postflight mismatch: $field" } }_x000A_ $state = Get-Content -LiteralPath (Join-Path $script:hvOverrideCache 'current-turn.yaml') -Raw | ConvertFrom-Yaml_x000A_ $receipt = [ordered]@{timestampLocal=(Get-Date -Format o);sourceFile=$SourceFile;buildStatus=$state.lastBuildStatus;nativeUnchanged=$true;cleanSourceStatus=@(git -C $script:phase2Source status --porcelain=v1 --untracked-files=all)}_x000A_ $receipt | ConvertTo-Json -Depth 4 | Out-File -LiteralPath (Join-Path $script:phase2Root ($Name + '-result.json')) -Encoding utf8_x000A_ $receipt | ConvertTo-Json -Depth 4_x000A_ if ($state.lastBuildStatus -eq 'failed') { throw 'Code verification failed; fix before next edit.' }_x000A_</S>
            </En>
            <En>
              <S N="Key">Get-PhaseNativeState</S>
              <S N="Value">_x000A_ param([string]$ReceiptPath)_x000A_ $nativeRoot='F:\GitHub\vice-sharp\native\vice'_x000A_ $gitlink=(&amp; git ls-tree HEAD native/vice) -join "`n"_x000A_ $head=(&amp; git -C $nativeRoot rev-parse HEAD) -join "`n"_x000A_ $delta=(&amp; git -C $nativeRoot diff --binary --no-ext-diff) -join "`n"_x000A_ $untracked=@(&amp; git -C $nativeRoot ls-files --others --exclude-standard | Sort-Object -CaseSensitive)_x000A_ $tracked=@(&amp; git -C $nativeRoot diff --name-only --no-ext-diff)_x000A_ $inventory=@(Get-ChildItem -LiteralPath $nativeRoot -Recurse -File -Force | Where-Object { $_.FullName -notmatch '[\\/]\.git([\\/]|$)' } | Sort-Object FullName -CaseSensitive | ForEach-Object { [ordered]@{path=[IO.Path]::GetRelativePath($nativeRoot,$_.FullName).Replace('\','/');sha256=(Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash;length=$_.Length;lastWriteUtc=$_.LastWriteTimeUtc.ToString('o')} })_x000A_ $hashText={param([string]$text) [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($text)))}_x000A_ $result=[ordered]@{timestampLocal=(Get-Date -Format o);root=$nativeRoot;gitlink=$gitlink;head=$head;trackedDiffSha256=(&amp; $hashText $delta);untrackedListSha256=(&amp; $hashText ($untracked -join "`n"));inventorySha256=(&amp; $hashText (($inventory | ForEach-Object { '{0}|{1}|{2}' -f $_.path,$_.length,$_.sha256 }) -join "`n"));newestSourceWriteUtc=($inventory.lastWriteUtc | Sort-Object -Descending | Select-Object -First 1);fileCount=$inventory.Count;trackedModified=$tracked;untrackedCount=$untracked.Count;inventory=$inventory}_x000A_ $result | ConvertTo-Json -Depth 8 | Out-File -LiteralPath $ReceiptPath -Encoding utf8_x000A_ return [pscustomobject]$result_x000A_</S>
            </En>
          </DCT>
        </Obj>
      </En>
    </DCT>
  </Obj>
</Objs>